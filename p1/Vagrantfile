Vagrant.configure("2") do |config|

  if ENV["VAGRANT_DEFAULT_PROVIDER"].to_s.empty?
    if system("command -v VBoxManage >/dev/null 2>&1")
      ENV["VAGRANT_DEFAULT_PROVIDER"] = "virtualbox"
    elsif Vagrant.has_plugin?("vagrant-libvirt")
      ENV["VAGRANT_DEFAULT_PROVIDER"] = "libvirt"
    end
  end

  config.vm.box = "centos/7"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 1200
  config.ssh.connect_timeout = 30
  kvm_available = File.exist?("/dev/kvm")


  # SERVER MACHINE

  config.vm.define "sobouricS" do |server|
    server.vm.hostname = "sobouricS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "sobouricS"
      vb.memory = 1024
      vb.cpus = 1
    end

    server.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.driver = kvm_available ? "kvm" : "qemu"
      lv.machine_type = "q35"
    end

    server.vm.provision "shell", path: "scripts/install_k3s_server.sh"
  end

  # SERVER-WORKER MACHINE
 
  config.vm.define "sobouricSW" do |worker|
    worker.vm.hostname = "sobouricSW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provider "virtualbox" do |vb|
      vb.name = "sobouricSW"
      vb.memory = 1024
      vb.cpus = 1
    end

    worker.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.driver = kvm_available ? "kvm" : "qemu"
      lv.machine_type = "q35"
    end

    worker.vm.provision "shell", path: "scripts/install_k3s_agent.sh"
  end

end
