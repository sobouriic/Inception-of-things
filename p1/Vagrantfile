Vagrant.configure("2") do |config|
  require "securerandom"

  ENV["VAGRANT_DEFAULT_PROVIDER"] = "libvirt"

  # Modern CentOS box (CentOS Stream 9).
  config.vm.box = "generic/centos9s"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 1200
  config.ssh.connect_timeout = 30
  kvm_available = File.exist?("/dev/kvm")

  confs_dir = File.join(File.dirname(__FILE__), "confs")
  token_file = File.join(confs_dir, "k3s_token")
  Dir.mkdir(confs_dir) unless Dir.exist?(confs_dir)
  if !File.exist?(token_file) || File.zero?(token_file)
    token = SecureRandom.hex(32)
    File.write(token_file, token + "\n")
    File.chmod(0600, token_file)
  end
  k3s_token = File.read(token_file).strip


  # SERVER MACHINE

  config.vm.define "sobouricS" do |server|
    server.vm.hostname = "sobouricS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.driver = kvm_available ? "kvm" : "qemu"
      lv.machine_type = "q35"
    end

    server.vm.provision "shell", path: "scripts/install_k3s_server.sh", env: { "K3S_SHARED_TOKEN" => k3s_token }
  end

  # SERVER-WORKER MACHINE
 
  config.vm.define "sobouricSW" do |worker|
    worker.vm.hostname = "sobouricSW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.driver = kvm_available ? "kvm" : "qemu"
      lv.machine_type = "q35"
    end

    worker.vm.provision "shell", path: "scripts/install_k3s_agent.sh", env: { "K3S_SHARED_TOKEN" => k3s_token }
  end

end
